<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>tech.redfoxlabs.Pianola</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Pianola</name>
  <summary>Browse, scrub, and audition MIDI recordings</summary>
  <description>
    <p>
      Pianola is a modern, lightweight GNOME application designed to preview, scrub, and timeline-browse MIDI recordings. Built as the graphical companion to the Midikeep background recording engine, Pianola presents a seamless continuous roll across takes and practice sessions.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Continuous infinite timeline browsing across takes, days, and archives</li>
      <li>Dorico-style acoustic scrubbing with note and damper pedal hover audition</li>
      <li>Integrated FluidSynth playback engine with General MIDI soundfont synthesis</li>
      <li>Multi-track view with dynamic instrument channel separation and pitch lanes</li>
      <li>Marquee time range selection and native drag-and-drop into DAWs, MuseScore, Dorico, and file managers</li>
      <li>Automatic section boundary detection with quick jump navigation</li>
      <li>Day-scoped macro overview minimap and browser-style smooth autoscroll</li>
    </ul>
  </description>

  <developer id="tech.redfoxlabs">
    <name>Matthew Samson (Red Fox Labs)</name>
  </developer>

  <url type="homepage">https://github.com/snakeeyes021/pianola</url>
  <url type="vcs-browser">https://github.com/snakeeyes021/pianola</url>
  <url type="bugtracker">https://github.com/snakeeyes021/pianola/issues</url>

  <translation type="gettext">pianola</translation>
  <launchable type="desktop-id">tech.redfoxlabs.Pianola.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#e01b24</color>
    <color type="primary" scheme_preference="dark">#c01c28</color>
  </branding>

  <releases>
    <release version="0.2.0" date="2026-11-04">
      <description>
        <p>Per-track selection and a much better drag-out into DAWs and notation programs:</p>
        <ul>
          <li>Per-track selection in Multi-Track view: drag within a lane to select that stretch of one track, drag across lanes to select it on several, and Ctrl-drag to add or subtract individual track stretches</li>
          <li>Drag a marquee selection straight into Bitwig, Reaper, Ardour, Dorico, MuseScore or Nautilus; dragged slices now carry real host file paths, so the drop works from the Flatpak (fixes selection drops that Dorico accepted and then ignored)</li>
          <li>Right-click selection menu: Copy, Export Selection, Play Selection, Select Whole Track, Select All and Clear Selection</li>
          <li>Whole-track selection and drag: double-click a lane or click a track header, then drag the track out as its own MIDI file</li>
          <li>Marquee selections auto-scroll the timeline when you drag past either edge</li>
          <li>Ctrl+C copies the selection, Ctrl+A selects everything, Escape clears the selection</li>
          <li>Exported slices are standard MIDI Type 1 files with a tempo and time signature track and named instrument tracks, so bars line up in notation programs</li>
          <li>Pianola reads the Midikeep archive location from the shared ~/.config/midikeep/config.yaml, so it follows wherever Midikeep stores your recordings</li>
          <li>A properly drawn piano keyboard beside the piano roll, with black keys aligned to their note rows</li>
          <li>Fixed drag-out from a selection silently failing after Ctrl was released in another window, and a star click toggling twice</li>
        </ul>
      </description>
    </release>
    <release version="0.1.1" date="2026-10-10">
      <description>
        <p>Day-scoped timeline scalability, seamless boundary crossing, and layout refinements:</p>
        <ul>
          <li>Day-scoped timeline canvas and layout for high-performance archive navigation</li>
          <li>Seamless cross-day playback and section navigation across day boundaries</li>
          <li>Collision-bounded clip headers and flag chips with hover expansion tooltips</li>
          <li>Exact temporal flag marker positioning and tick marks on the overview minimap</li>
          <li>Clean single-file mode header badges without archive date formatting</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-06">
      <description>
        <p>Initial release of Pianola:</p>
        <ul>
          <li>Midikeep archive integration and continuous timeline scrolling</li>
          <li>FluidSynth playback engine with General MIDI soundfont support</li>
          <li>Acoustic scrubbing and hover sustain auditioning</li>
          <li>Unified single-instrument and multi-track piano roll views</li>
          <li>Marquee slice selection and native drag-and-drop export</li>
          <li>Day-scoped overview minimap and smooth autoscrolling</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
