<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>tech.redfoxlabs.Pianola</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Pianola</name>
  <summary>Browse, scrub, and audition MIDI recordings</summary>
  <description>
    <p>
      Pianola is a modern, lightweight GNOME application designed to preview, scrub, and timeline-browse MIDI recordings. Built as the graphical companion to the Midikeep background recording engine, Pianola presents a seamless continuous roll across takes and practice sessions.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Continuous infinite timeline browsing across takes, days, and archives</li>
      <li>Dorico-style acoustic scrubbing with note and damper pedal hover audition</li>
      <li>Integrated FluidSynth playback engine with General MIDI soundfont synthesis</li>
      <li>Multi-track view with dynamic instrument channel separation and pitch lanes</li>
      <li>Marquee time range selection and native drag-and-drop into DAWs, MuseScore, Dorico, and file managers</li>
      <li>Automatic section boundary detection with quick jump navigation</li>
      <li>Day-scoped macro overview minimap and browser-style smooth autoscroll</li>
    </ul>
  </description>

  <developer id="tech.redfoxlabs">
    <name>Matthew Samson (Red Fox Labs)</name>
  </developer>

  <url type="homepage">https://github.com/snakeeyes021/pianola</url>
  <url type="vcs-browser">https://github.com/snakeeyes021/pianola</url>
  <url type="bugtracker">https://github.com/snakeeyes021/pianola/issues</url>

  <translation type="gettext">pianola</translation>
  <launchable type="desktop-id">tech.redfoxlabs.Pianola.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#e01b24</color>
    <color type="primary" scheme_preference="dark">#c01c28</color>
  </branding>

  <releases>
    <release version="0.1.0" date="2026-10-06">
      <description>
        <p>Initial release of Pianola:</p>
        <ul>
          <li>Midikeep archive integration and continuous timeline scrolling</li>
          <li>FluidSynth playback engine with General MIDI soundfont support</li>
          <li>Acoustic scrubbing and hover sustain auditioning</li>
          <li>Unified single-instrument and multi-track piano roll views</li>
          <li>Marquee slice selection and native drag-and-drop export</li>
          <li>Day-scoped overview minimap and smooth autoscrolling</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
