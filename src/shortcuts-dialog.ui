<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="AdwShortcutsDialog" id="shortcuts_dialog">
    <child>
      <object class="AdwShortcutsSection">
        <property name="title" translatable="yes">Playback &amp; Audition</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Play / Pause from Cursor</property>
            <property name="accelerator">space</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Play from Selection</property>
            <property name="accelerator">p</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Acoustic Hover Sustain Scrub</property>
            <property name="accelerator">&lt;Primary&gt;space</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Next Section Boundary (≥ 3s silence)</property>
            <property name="accelerator">bracketright</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Previous Section Boundary</property>
            <property name="accelerator">bracketleft</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Next Recording Day</property>
            <property name="accelerator">&lt;Alt&gt;Right</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Previous Recording Day</property>
            <property name="accelerator">&lt;Alt&gt;Left</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection">
        <property name="title" translatable="yes">Timeline &amp; File</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Open MIDI File</property>
            <property name="accelerator">&lt;Primary&gt;o</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Export Marquee Slice or File</property>
            <property name="accelerator">&lt;Primary&gt;e</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Toggle Multi-Track View</property>
            <property name="accelerator">&lt;Primary&gt;t</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Zoom In</property>
            <property name="accelerator">&lt;Primary&gt;plus</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Zoom Out</property>
            <property name="accelerator">&lt;Primary&gt;minus</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Quit</property>
            <property name="accelerator">&lt;Primary&gt;q</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
